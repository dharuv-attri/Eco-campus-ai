# ---------------------------------------------------------------------------
# EcoCampus AI environment template
# The app works with zero external credentials for local evaluation.
# NEVER commit real secrets. Copy to .env.local and fill only what you need.
# ---------------------------------------------------------------------------

# Public site URL (used for OAuth callbacks, verification links, QR codes)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local SQLite database file (default: ./data/ecocampus.db)
DATABASE_PATH=./data/ecocampus.db

# Session signing/encryption secret (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=replace-with-a-long-random-secret

# ---------------------------------------------------------------------------
# Google OAuth (optional). Create credentials at console.cloud.google.com
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Email delivery (optional). Without these, emails are stored in email_outbox
# and verification/reset links are shown on-screen in this demo.
# Supported provider: Resend (https://resend.com)
#
# Auth codes: email signup, passwordless "one-time code" sign-in and magic
# links all work without delivery configured in demo mode - the 6-digit code
# and link are shown on-screen instead of emailed. Set RESEND_API_KEY +
# EMAIL_FROM (and NEXT_PUBLIC_APP_URL to a public URL) to send real emails.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="EcoCampus AI <notifications@your-domain.example>"

# Auto-verify new email signups (set true only for controlled demos)
AUTO_VERIFY_EMAIL=false

# Restrict registrations to a university domain (leave blank to allow any)
ALLOWED_EMAIL_DOMAIN=

# ---------------------------------------------------------------------------
# AI provider (optional). Any OpenAI-compatible chat completions endpoint.
# OpenAI example:
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_MODEL=gpt-4o-mini
# Groq example:
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=llama-3.3-70b-versatile
# Without a key, EcoBot uses a safe deterministic assistant.
# ---------------------------------------------------------------------------
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Initial super administrator (used only by `npm run db:seed`)
SEED_ADMIN_NAME="Platform Administrator"
SEED_ADMIN_EMAIL=admin@ecocampus.local
SEED_ADMIN_PASSWORD=EcoAdmin#2026
