# ---------------------------------------------------------------------------
# EcoCampus AI environment template
# Supabase provides PostgreSQL (application data), Auth (accounts/sessions)
# and Storage (uploaded images). Copy this file to .env.local and fill in the
# real values. NEVER commit .env.local or real secrets.
# ---------------------------------------------------------------------------

# Public site URL. Used for OAuth callbacks, email links, QR codes and shares.
# Use an https URL in production (for example your Render URL).
# Add "<NEXT_PUBLIC_APP_URL>/api/auth/google/callback" to Supabase Auth
# Redirect URLs, and register Supabase's Google callback with Google Cloud.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (server-only)
# Prefer the Supabase "Session pooler" connection string. DATABASE_URL is also
# accepted as a fallback. Never expose this through a NEXT_PUBLIC_ variable.
# ---------------------------------------------------------------------------
DATABASE_URL=
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------
# Supabase Auth (browser-safe values only)
# Get these from Supabase -> Project Settings -> API.
# NEXT_PUBLIC_SUPABASE_ANON_KEY is accepted for legacy projects.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Supabase Storage (server-only)
# Required in production for image uploads and for copying legacy uploads.
# Use the service_role key from Supabase -> Project Settings -> API.
# Local development falls back to public/uploads when this is empty; that
# fallback is not persistent on Render and is rejected in production.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ecocampus-uploads

# ---------------------------------------------------------------------------
# First Admin setup (server-only, optional)
# Only needed when no admin account exists yet. Use at least 32 characters.
# An existing super-admin session can authorize setup without this token.
# ---------------------------------------------------------------------------
ADMIN_SETUP_TOKEN=

# ---------------------------------------------------------------------------
# Email delivery
# Account emails (verification, password reset, magic links, 6-digit codes)
# are sent by Supabase Auth. Configure SMTP (for example Brevo) in
# Supabase -> Authentication -> Settings -> SMTP, and include {{ .Token }} in
# the signup/recovery email templates to support numeric codes.
# RESEND_API_KEY/EMAIL_FROM are legacy and are not used by Supabase Auth.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=

# ---------------------------------------------------------------------------
# AI provider (optional). Any OpenAI-compatible chat completions endpoint.
# OpenAI example:
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_MODEL=gpt-4o-mini
# Groq example:
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=llama-3.3-70b-versatile
# Without a key, EcoBot uses a safe deterministic assistant.
# ---------------------------------------------------------------------------
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
